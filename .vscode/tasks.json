{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "C:\\Program Files (x86)\\Microsoft Visual Studio\\2019\\BuildTools\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "type": "process",
            "args": [
                "${workspaceFolder}/SCJMapper-V2.csproj",
                "/t:Rebuild",
                "/p:Configuration=Debug",
                "/p:Platform=x86",
                "/p:RestoreProjectStyle=PackagesConfig",
                "/p:SolutionDir=${workspaceFolder}/",
                "/v:minimal"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/SCJMapper.Tests/SCJMapper.Tests.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/SCJMapper.Tests/SCJMapper.Tests.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}